# 对话模型（OpenAI 兼容 API）
CHAT_MODEL_NAME=
CHAT_API_KEY=
CHAT_BASE_URL=

# Embedding 模型（可以与对话模型使用不同的 Key 和网址）
EMBEDDING_MODEL_NAME=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=

# PostgreSQL：只持久化 LangGraph 会话、消息、Tool 调用和上下文
DB_URL=postgresql://username:password@localhost:5432?sslmode=disable
POSTGRES_DATABASE=customer_service_agent

# Milvus：文档向量。本机默认端口通常是 19530。
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DATABASE=default
MILVUS_COLLECTION=customer_service_knowledge

RETRIEVAL_TOP_K=4

# 可选：LangSmith Tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=customer-service-agent
